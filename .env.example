# Copy to .env (git-ignored) and fill in. Never commit .env or paste keys in chat.

# 1. NVIDIA Nemotron (reviewer model) — https://build.nvidia.com  → key starts with nvapi-
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=            # exact model id from the model's page, e.g. nvidia/<nemotron-3.5-super-vl...>

# 2. OpenAI (author agent / Codex) — https://platform.openai.com/api-keys → starts with sk-
OPENAI_API_KEY=

# 3. Modal — no key here: run `uv run modal token new` once; it saves to ~/.modal.toml

# 4. Gemma (second reviewer, different family) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-3-27b-it

# 5. Aiven Postgres (review records + reviewer track record) — Service URI from console.aiven.io
DATABASE_URL=              # postgres://avnadmin:...@...aivencloud.com:12345/defaultdb?sslmode=require

# Optional: Verda hosted Nemotron (EU) — only if you go for Tier C
VERDA_API_KEY=
VERDA_BASE_URL=
